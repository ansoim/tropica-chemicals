name: Publish dashboard and process SharePoint refresh

on:
  push:
    branches: [main]
    paths:
      - "data/sales.json"
      - "index.html"
      - "assets/**"
      - ".github/workflows/refresh-dashboard.yml"
      - "scripts/**"
  workflow_dispatch:
  repository_dispatch:
    types: [dashboard-sales-updated]

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: tropica-pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Get dashboard files
        uses: actions/checkout@v4
      - name: Save new workbook summary
        if: github.event_name == 'repository_dispatch'
        env:
          DASHBOARD_JSON: ${{ toJSON(github.event.client_payload.dashboardJson) }}
        run: python scripts/write_dispatch_data.py
      - name: Commit refreshed data
        if: github.event_name == 'repository_dispatch'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/sales.json
          if git diff --cached --quiet; then
            echo "The workbook summary is unchanged; no commit is needed."
          else
            git commit -m "Refresh dashboard data from SharePoint"
            git push
          fi
      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5
      - name: Upload dashboard to Pages
        uses: actions/upload-pages-artifact@v3
        with:
          path: .
      - name: Deploy dashboard
        id: deployment
        uses: actions/deploy-pages@v4
